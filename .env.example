# SDKWork Canvas 环境变量示例
# 复制为 .env 并根据环境修改

# === 数据库配置 ===
# PostgreSQL: postgres://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev

# 应用根目录(用于定位 database/ 资产)
SDKWORK_SETTINGS_APP_ROOT=.

# === HTTP 服务配置 ===
SDKWORK_SETTINGS_API_BIND=0.0.0.0:8080
SDKWORK_SETTINGS_GATEWAY_BIND=0.0.0.0:8080

# === ID 生成配置 ===
SDKWORK_SETTINGS_ID_NODE_ID=0

# === 日志配置 ===
RUST_LOG=info
SDKWORK_SETTINGS_LOG_FORMAT=full

# === IAM 配置 ===
SDKWORK_IAM_JWT_ISSUER=https://iam.sdkwork.com
SDKWORK_IAM_JWT_AUDIENCE=sdkwork-canvas
SDKWORK_IAM_JWKS_URL=https://iam.sdkwork.com/.well-known/jwks.json

# === Drive 配置 ===
# 默认进程内调用 sdkwork-drive(宿主 PostgreSQL 连接池),无需端点或服务凭据。
# 仅分离部署(Drive 在另一进程/容器)时显式启用 HTTP:
# SDKWORK_CANVAS_DRIVE_MODE=http
# SDKWORK_DRIVE_FACADE_URL=https://api.sdkwork.com
# 本地开发无 PostgreSQL 时可显式使用内存 Drive:
# SDKWORK_CANVAS_DRIVE_MODE=memory

# === 部署 profile ===
SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=standalone

# === 运行时拓扑(Phase 1 静态) ===
SDKWORK_SETTINGS_SERVICE_NAME=sdkwork-canvas-api-server
