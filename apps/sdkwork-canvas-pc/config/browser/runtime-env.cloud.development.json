{
  "environment": "development",
  "deploymentProfile": "cloud",
  "profileId": "cloud.development",
  "runtimeTarget": "browser",
  "browserOriginMode": "cross-origin",
  "$comment": "浏览器公开运行时配置(development 示例)。仅包含公开的 SDK 基址、特性开关与应用元数据,严禁包含密钥、数据库地址、令牌或私有服务端点。",
  "env": "development",
  "app": {
    "appId": "sdkwork-canvas-pc",
    "displayName": "SDKWork Canvas",
    "version": "0.1.0"
  },
  "api": {
    "baseUrl": "http://localhost:8080",
    "appApiPrefix": "/api/app/v3",
    "backendApiPrefix": "/api/backend/v3"
  },
  "runtime": {
    "defaultLocale": "zh-CN",
    "defaultTheme": "light",
    "timezone": "Asia/Shanghai"
  },
  "featureFlags": {
    "userPreferences": true,
    "tenantConfig": false,
    "systemSettings": false
  },
  "appApiBaseUrl": "http://127.0.0.1:3900",
  "backendApiBaseUrl": "http://127.0.0.1:3900",
  "driveAppApiBaseUrl": "http://127.0.0.1:3900",
  "appbaseAppApiBaseUrl": "http://127.0.0.1:3900",
  "deployAppApiBaseUrl": "http://127.0.0.1:3900",
  "openApiBaseUrl": "http://127.0.0.1:3900",
  "sdkBaseUrl": "http://127.0.0.1:3900",
  "cloudApiBaseUrls": [
    "https://api-dev.sdkwork.com",
    "https://api-dev.birdcoder.com",
    "https://api-dev.dtupay.com",
    "https://api-dev.sdkwork.cn",
    "https://api-dev.birdcoder.cn",
    "https://api-dev.dtupay.cn",
    "https://api-dev.skubc.com",
    "https://api-dev.skubc.cn",
    "https://api-dev.zowalk.com",
    "https://api-dev.zowalk.cn",
    "https://api-dev.offer86.com",
    "https://api-dev.offer86.cn",
    "https://api-dev.86offer.com",
    "https://api-dev.86offer.cn"
  ]
}
