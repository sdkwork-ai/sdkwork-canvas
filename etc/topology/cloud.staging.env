# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_CANVAS_DEPLOYMENT_PROFILE=cloud
SDKWORK_CANVAS_ENVIRONMENT=staging
SDKWORK_CANVAS_PROFILE_ID=cloud.staging
SDKWORK_CANVAS_APPLICATION_PUBLIC_HTTP_URL=https://canvas-staging.sdkwork.com
SDKWORK_CANVAS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CANVAS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

