# SDKWork production defaults (both deployment profiles)
SDKWORK_CANVAS_ENVIRONMENT=production
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_CORS_ALLOWED_ORIGINS=https://canvas.sdkwork.com,https://canvas.birdcoder.com,https://canvas.dtupay.com,https://canvas.noaper.com,https://canvas.sdkwork.cn,https://canvas.birdcoder.cn,https://canvas.dtupay.cn,https://canvas.noaper.cn,https://canvas.skubc.com,https://canvas.skubc.cn,https://canvas.zowalk.com,https://canvas.zowalk.cn,https://canvas.offer86.com,https://canvas.offer86.cn,https://canvas.86offer.com,https://canvas.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
SDKWORK_CANVAS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8787
SDKWORK_CANVAS_USE_MEMORY_DRIVE=0
SDKWORK_DRIVE_FACADE_URL=https://api.sdkwork.com
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32
