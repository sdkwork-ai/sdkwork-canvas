# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated demo PostgreSQL schema/database `sdkwork_canvas_demo` (DB identity).
# Redis isolation: any cache/rate-limit keys use a dedicated logical DB index so no key collides
# with another shared-redis environment. This profile declares no concrete redis/database env keys;
# provisioning must assign them before activation.
SDKWORK_CANVAS_DEPLOYMENT_PROFILE=standalone
SDKWORK_CANVAS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CANVAS_PROFILE_ID=standalone.demo
SDKWORK_CANVAS_APPLICATION_PUBLIC_HTTP_URL=https://canvas-demo.sdkwork.com
SDKWORK_CANVAS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
VITE_SDKWORK_CANVAS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CANVAS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://canvas-demo.sdkwork.com,http://canvas-demo.sdkwork.com,https://canvas-demo.birdcoder.com,http://canvas-demo.birdcoder.com,https://canvas-demo.dtupay.com,http://canvas-demo.dtupay.com,https://canvas-demo.noaper.com,http://canvas-demo.noaper.com,https://canvas-demo.sdkwork.cn,http://canvas-demo.sdkwork.cn,https://canvas-demo.birdcoder.cn,http://canvas-demo.birdcoder.cn,https://canvas-demo.dtupay.cn,http://canvas-demo.dtupay.cn,https://canvas-demo.noaper.cn,http://canvas-demo.noaper.cn,https://canvas-demo.skubc.com,http://canvas-demo.skubc.com,https://canvas-demo.skubc.cn,http://canvas-demo.skubc.cn,https://canvas-demo.zowalk.com,http://canvas-demo.zowalk.com,https://canvas-demo.zowalk.cn,http://canvas-demo.zowalk.cn,https://canvas-demo.offer86.com,http://canvas-demo.offer86.com,https://canvas-demo.offer86.cn,http://canvas-demo.offer86.cn,https://canvas-demo.86offer.com,http://canvas-demo.86offer.com,https://canvas-demo.86offer.cn,http://canvas-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
